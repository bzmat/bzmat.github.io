  <!-- ======================================================
       INTERACTIVE JAVASCRIPT (DISCRETE BAYES + BETA-BINOMIAL)
       ====================================================== -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      /* --- PART A: DISCRETE IDS BAYES CALCULATOR --- */
      const idsPrior = document.getElementById("ids-prior");
      const idsTpr = document.getElementById("ids-tpr");
      const idsFpr = document.getElementById("ids-fpr");
      const idsPriorVal = document.getElementById("ids-prior-val");
      const idsTprVal = document.getElementById("ids-tpr-val");
      const idsFprVal = document.getElementById("ids-fpr-val");
      const idsOutput = document.getElementById("ids-output");

      function updateIDS() {
        const pH = parseFloat(idsPrior.value) / 100;
        const pE_H = parseFloat(idsTpr.value) / 100;
        const pE_notH = parseFloat(idsFpr.value) / 100;

        idsPriorVal.textContent = (pH * 100).toFixed(1) + "%";
        idsTprVal.textContent = (pE_H * 100).toFixed(1) + "%";
        idsFprVal.textContent = (pE_notH * 100).toFixed(1) + "%";

        const pNotH = 1 - pH;
        const pE = pE_H * pH + pE_notH * pNotH; // Marginal likelihood / total alert probability
        const pH_E = (pE_H * pH) / pE;          // Posterior P(Attack | Alert)

        // Second independent alert update (sequential Bayesian updating)
        const pE2 = pE_H * pH_E + pE_notH * (1 - pH_E);
        const pH_E2 = (pE_H * pH_E) / pE2;

        idsOutput.innerHTML =
          `Evidence P(Alert)                  : ${(pE * 100).toFixed(3)}%\n` +
          `Posterior after 1 Alert  P(H | E)  : <span class="highlight">${(pH_E * 100).toFixed(2)}%</span>\n` +
          `Sequential Update (2nd Alert)      : <span class="highlight">${(pH_E2 * 100).toFixed(2)}%</span>\n\n` +
          `Takeaway: Even with ${(pE_H * 100).toFixed(1)}% sensitivity, a low prior base rate of ${(pH * 100).toFixed(1)}% means ` +
          `an isolated alert has only a ${(pH_E * 100).toFixed(1)}% chance of being a true attack. ` +
          `Sequential updating with a second independent detector raises confidence to ${(pH_E2 * 100).toFixed(1)}%.`;
      }

      [idsPrior, idsTpr, idsFpr].forEach(el => el.addEventListener("input", updateIDS));
      updateIDS();

      /* --- PART B: BETA-BINOMIAL CONJUGATE UPDATER --- */
      const alphaSlider = document.getElementById("beta-alpha");
      const betaSlider = document.getElementById("beta-beta");
      const nSlider = document.getElementById("bin-n");
      const kSlider = document.getElementById("bin-k");

      const alphaVal = document.getElementById("beta-alpha-val");
      const betaVal = document.getElementById("beta-beta-val");
      const nVal = document.getElementById("bin-n-val");
      const kVal = document.getElementById("bin-k-val");
      const betaOutput = document.getElementById("beta-output");
      const canvas = document.getElementById("bayes-canvas");
      const ctx = canvas.getContext("2d");

      // Lanczos approximation for ln(Gamma(z)) to avoid factorial overflow
      function logGamma(z) {
        const g = 7;
        const p = [
          0.99999999999980993, 676.5203681218851, -1259.1392167224028,
          771.32342877765313, -176.61502916214059, 12.507343278686905,
          -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7
        ];
        if (z < 0.5) {
          return Math.log(Math.PI / Math.sin(Math.PI * z)) - logGamma(1 - z);
        }
        z -= 1;
        let x = p[0];
        for (let i = 1; i < g + 2; i++) {
          x += p[i] / (z + i);
        }
        const t = z + g + 0.5;
        return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x);
      }

      function betaPDF(x, a, b) {
        if (x <= 0 || x >= 1) return 0;
        const logNorm = logGamma(a + b) - logGamma(a) - logGamma(b);
        return Math.exp(logNorm + (a - 1) * Math.log(x) + (b - 1) * Math.log(1 - x));
      }

      function updateBetaBinomial() {
        const a = parseInt(alphaSlider.value, 10);
        const b = parseInt(betaSlider.value, 10);
        const n = parseInt(nSlider.value, 10);

        // Keep k <= n
        kSlider.max = n;
        if (parseInt(kSlider.value, 10) > n) {
          kSlider.value = n;
        }
        const k = parseInt(kSlider.value, 10);

        alphaVal.textContent = a;
        betaVal.textContent = b;
        nVal.textContent = n;
        kVal.textContent = k;

        const postA = a + k;
        const postB = b + (n - k);

        const priorMean = a / (a + b);
        const mle = k / n;
        const postMean = postA / (postA + postB);
        const postVar = (postA * postB) / (Math.pow(postA + postB, 2) * (postA + postB + 1));
        const priorWeight = (a + b) / (a + b + n);

        betaOutput.innerHTML =
          `Prior Mean     [α / (α+β)]          : ${priorMean.toFixed(4)}  (Prior weight: ${(priorWeight * 100).toFixed(1)}%)\n` +
          `Likelihood MLE [k / n]              : ${mle.toFixed(4)}  (Data weight : ${((1 - priorWeight) * 100).toFixed(1)}%)\n` +
          `Posterior Mean [(α+k) / (α+β+n)]    : <span class="highlight">${postMean.toFixed(4)}</span>  (Posterior SD: ${Math.sqrt(postVar).toFixed(4)})`;

        drawBetaPlot(a, b, k, n, postA, postB);
      }

      function drawBetaPlot(a, b, k, n, postA, postB) {
        const w = canvas.width;
        const h = canvas.height;
        const padL = 45, padR = 20, padT = 20, padB = 35;
        const plotW = w - padL - padR;
        const plotH = h - padT - padB;

        ctx.clearRect(0, 0, w, h);

        const steps = 250;
        const xs = [];
        const priorY = [];
        const postY = [];
        const likeY = [];

        // Normalize likelihood to Beta(k+1, n-k+1) density for clean visual comparison on same axis
        let maxY = 0;
        for (let i = 1; i < steps; i++) {
          const x = i / steps;
          const yPr = betaPDF(x, a, b);
          const yPo = betaPDF(x, postA, postB);
          const yLk = betaPDF(x, k + 1, n - k + 1);
          xs.push(x);
          priorY.push(yPr);
          postY.push(yPo);
          likeY.push(yLk);
          if (yPr > maxY) maxY = yPr;
          if (yPo > maxY) maxY = yPo;
          if (yLk > maxY) maxY = yLk;
        }
        maxY = Math.max(maxY * 1.12, 1.5);

        const mapX = (x) => padL + x * plotW;
        const mapY = (y) => padT + plotH - (y / maxY) * plotH;

        // Grid & Axes
        ctx.strokeStyle = "#2b2b2b";
        ctx.lineWidth = 1;
        ctx.fillStyle = "#888";
        ctx.font = "11px monospace";

        for (let i = 0; i <= 5; i++) {
          const yVal = (i / 5) * maxY;
          const py = mapY(yVal);
          ctx.beginPath();
          ctx.moveTo(padL, py);
          ctx.lineTo(w - padR, py);
          ctx.stroke();
          ctx.textAlign = "right";
          ctx.textBaseline = "middle";
          ctx.fillText(yVal.toFixed(1), padL - 6, py);
        }

        for (let i = 0; i <= 10; i++) {
          const xVal = i / 10;
          const px = mapX(xVal);
          ctx.beginPath();
          ctx.moveTo(px, padT);
          ctx.lineTo(px, h - padB);
          ctx.stroke();
          ctx.textAlign = "center";
          ctx.textBaseline = "top";
          ctx.fillText(xVal.toFixed(1), px, h - padB + 8);
        }

        // Helper to plot curve
        function plotCurve(ys, color, lineWidth, dashed, fillAlpha) {
          ctx.save();
          ctx.beginPath();
          if (dashed) ctx.setLineDash([6, 4]);
          for (let i = 0; i < xs.length; i++) {
            const px = mapX(xs[i]);
            const py = mapY(ys[i]);
            if (i === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          }
          ctx.strokeStyle = color;
          ctx.lineWidth = lineWidth;
          ctx.stroke();

          if (fillAlpha) {
            ctx.lineTo(mapX(xs[xs.length - 1]), mapY(0));
            ctx.lineTo(mapX(xs[0]), mapY(0));
            ctx.closePath();
            ctx.fillStyle = fillAlpha;
            ctx.fill();
          }
          ctx.restore();
        }

        // Draw Prior, Likelihood (scaled), and Posterior
        plotCurve(priorY, "#00bcd4", 2, false, "rgba(0, 188, 212, 0.12)");
        plotCurve(likeY, "#aaaaaa", 1.8, true, null);
        plotCurve(postY, "#ff9800", 2.8, false, "rgba(255, 152, 0, 0.22)");

        // X-axis title
        ctx.fillStyle = "#bbb";
        ctx.textAlign = "center";
        ctx.fillText("Parameter θ (Breach Probability)", padL + plotW / 2, h - 10);
      }

      [alphaSlider, betaSlider, nSlider, kSlider].forEach(el => el.addEventListener("input", updateBetaBinomial));
      updateBetaBinomial();
    });
  </script>
