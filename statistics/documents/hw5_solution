  <!-- ==========================================
       JAVASCRIPT LOGIC FOR BOTH HOMEWORKS
       ========================================== -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      
      /* =========================================================
         HOMEWORK 1: INTEGRATION ENGINE
         ========================================================= */
      const btnIntegral = document.getElementById("btn-run-integral");
      const funcSelect = document.getElementById("func-select");
      const resIntegral = document.getElementById("integral-results");

      // Define the test functions
      const functions = {
        "sin": { f: (x) => Math.sin(x), a: 0, b: Math.PI, name: "sin(x) over [0, π]", expected: 2.0 },
        "x2": { f: (x) => x * x, a: 0, b: 1, name: "x² over [0, 1]", expected: 0.333333 },
        "step": { f: (x) => x < 0.5 ? 1 : 3, a: 0, b: 1, name: "Piecewise Step over [0, 1]", expected: 2.0 },
        "abs": { f: (x) => Math.abs(x - 0.5), a: 0, b: 1, name: "|x - 0.5| over [0, 1]", expected: 0.25 },
        "sinc": { f: (x) => x === 0 ? 1 : Math.sin(x)/x, a: 0, b: Math.PI, name: "sin(x)/x over [0, π]", expected: 1.851937 },
        "invsqrt": { f: (x) => x === 0 ? 0 : 1/Math.sqrt(x), a: 0.0001, b: 1, name: "1/√x over (0, 1] (Unbounded)", expected: 2.0 }
      };

      // Riemann Sum (Midpoint rule)
      function riemannIntegrate(f, a, b, N) {
        let sum = 0;
        const dx = (b - a) / N;
        for (let i = 0; i < N; i++) {
          let x = a + (i + 0.5) * dx;
          sum += f(x) * dx;
        }
        return sum;
      }

      // Numerical pseudo-Lebesgue Integration
      // Partitions the Y-axis and computes measure of pre-images
      function lebesgueIntegrate(f, a, b, N_X, N_Y) {
        const dx = (b - a) / N_X;
        let yValues = [];
        let minY = Infinity, maxY = -Infinity;
        
        // Sample the function to find range and build measure data
        for (let i = 0; i < N_X; i++) {
          let x = a + i * dx;
          let y = f(x);
          yValues.push(y);
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
        
        // Edge case for flat functions
        if (minY === maxY) return minY * (b - a);

        const dy = (maxY - minY) / N_Y;
        let sum = 0;
        
        // For each Y bin, find how many X samples fell into it (Measure of pre-image)
        for (let j = 0; j < N_Y; j++) {
          let yBinLower = minY + j * dy;
          let yBinUpper = yBinLower + dy;
          let yMid = yBinLower + (dy / 2);
          
          let count = 0;
          for (let k = 0; k < yValues.length; k++) {
            if (yValues[k] >= yBinLower && yValues[k] < yBinUpper) {
              count++;
            }
          }
          // The measure of this subset in the domain is (count * dx)
          let measure = count * dx;
          sum += yMid * measure;
        }
        return sum;
      }

      btnIntegral.addEventListener("click", () => {
        const config = functions[funcSelect.value];
        const N_Riem = 10000; 
        const N_X = 10000, N_Y = 1000;

        const t0 = performance.now();
        const resRiem = riemannIntegrate(config.f, config.a, config.b, N_Riem);
        const t1 = performance.now();

        const resLebs = lebesgueIntegrate(config.f, config.a, config.b, N_X, N_Y);
        const t2 = performance.now();

        resIntegral.innerHTML = `Function: <span class="highlight">${config.name}</span>\n\n` +
          `Expected Theoretical Value : ${config.expected.toFixed(6)}\n\n` +
          `[RIEMANN APPROACH]\nResult     : ${resRiem.toFixed(6)}\nTime       : ${(t1 - t0).toFixed(2)} ms\nEfficiency : Fast for continuous functions, struggles with spikes/asymptotes.\n\n` +
          `[LEBESGUE APPROACH]\nResult     : ${resLebs.toFixed(6)}\nTime       : ${(t2 - t1).toFixed(2)} ms\nEfficiency : Numerically slower due to binning, but conceptually required for pathological/fractal sets.`;
      });


      /* =========================================================
         HOMEWORK 2: NORMAL CDF ENGINE
         ========================================================= */
      const btnCDF = document.getElementById("btn-run-cdf");
      const zInput = document.getElementById("z-input");
      const resCDF = document.getElementById("cdf-results");

      // 1. PDF Function for numerical integration
      const normalPDF = (t) => (1 / Math.sqrt(2 * Math.PI)) * Math.exp(-0.5 * t * t);

      // Simpson's Rule for Numerical Integration
      function simpsonsRuleCDF(z) {
        const a = -8; // Approximation of -Infinity
        if (z < a) return 0;
        const N = 1000; // Must be even
        const h = (z - a) / N;
        let sum = normalPDF(a) + normalPDF(z);
        for (let i = 1; i < N; i += 2) sum += 4 * normalPDF(a + i * h);
        for (let i = 2; i < N - 1; i += 2) sum += 2 * normalPDF(a + i * h);
        return (h / 3) * sum;
      }

      // 2. Taylor Series for Erf
      // erf(x) = (2/√π) * sum((-1)^n * x^(2n+1) / (n! * (2n+1)))
      function taylorErf(x) {
        let sum = 0;
        let term = x;
        let n = 0;
        // Stop after 40 iterations or if terms get too small
        while (n < 40) {
          sum += term / (2 * n + 1);
          n++;
          term = -term * (x * x) / n;
          if (Math.abs(term) < 1e-15) break; 
        }
        return (2 / Math.sqrt(Math.PI)) * sum;
      }
      
      function taylorCDF(z) {
        if (Math.abs(z) > 4) return z > 0 ? 1 : 0; // Taylor diverges for large z due to float limits
        return 0.5 * (1 + taylorErf(z / Math.sqrt(2)));
      }

      // 3. Abramowitz & Stegun Approximation (Trusted Reference)
      function approxErf(x) {
        const sign = (x >= 0) ? 1 : -1;
        x = Math.abs(x);
        const a1 =  0.254829592;
        const a2 = -0.284496736;
        const a3 =  1.421413741;
        const a4 = -1.453152027;
        const a5 =  1.061405429;
        const p  =  0.3275911;
        const t = 1.0 / (1.0 + p * x);
        const y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);
        return sign * y;
      }

      function referenceCDF(z) {
        return 0.5 * (1 + approxErf(z / Math.sqrt(2)));
      }

      btnCDF.addEventListener("click", () => {
        const z = parseFloat(zInput.value);
        if (isNaN(z)) {
          resCDF.innerHTML = `<span style="color:#ff5555;">Please enter a valid number.</span>`;
          return;
        }

        const t0 = performance.now();
        const resSimpson = simpsonsRuleCDF(z);
        const t1 = performance.now();
        const resTaylor = taylorCDF(z);
        const t2 = performance.now();
        const resRef = referenceCDF(z);
        
        let taylorNote = "";
        if (Math.abs(z) > 4) taylorNote = " (Capped due to Taylor series divergence at extremes)";

        resCDF.innerHTML = `Computing Normal CDF for <span class="highlight">z = ${z}</span>\n\n` +
          `[TRUSTED REFERENCE (Abramowitz & Stegun)]\nResult : <span class="highlight">${resRef.toFixed(8)}</span>\n\n` +
          `[NUMERICAL INTEGRATION (Simpson's Rule)]\nResult : ${resSimpson.toFixed(8)}\nError  : ${Math.abs(resRef - resSimpson).toExponential(2)}\nTime   : ${(t1 - t0).toFixed(2)} ms\n\n` +
          `[SERIES EXPANSION (Taylor Series of erf)]\nResult : ${resTaylor.toFixed(8)}${taylorNote}\nError  : ${Math.abs(resRef - resTaylor).toExponential(2)}\nTime   : ${(t2 - t1).toFixed(2)} ms`;
      });
      
      // Auto-run first tests on load
      btnIntegral.click();
      btnCDF.click();

    });
  </script>
